# ==========================================================
# NOTES MANAGER - ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to version control.
# ==========================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=replace-with-a-secure-random-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- External AI / Quiz Generation API ---
# Compatible with Gemini REST API, OpenAI-compatible chat completions, or custom quiz endpoints.
# When API_KEY is left empty, the system uses its built-in NLP/heuristic fallback quiz generator for offline college demos.
API_KEY=
API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
API_TIMEOUT=30

# --- SMTP Email Configuration (For Progress Reports) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=notesmanager@localhost

# --- FTP Server Configuration (For Study Resource Transfer) ---
# Set FTP_MOCK_MODE=True when a live FTP server is unavailable during local college demonstration.
FTP_MOCK_MODE=True
FTP_HOST=127.0.0.1
FTP_PORT=2121
FTP_USER=student
FTP_PASSWORD=

# --- Local Socket Study Status Service ---
SOCKET_HOST=127.0.0.1
SOCKET_PORT=65432
