# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables & Secrets (NEVER COMMIT)
.env
.env.local
.env.development
.env.production
*.pem
*.key
secrets.json

# Django & SQLite database
db.sqlite3
db.sqlite3-journal
*.log
local_settings.py
staticfiles/

# Media uploads & generated exports (keep folder structure only)
media/*
!media/.gitkeep
ftp_local_storage/*
!ftp_local_storage/.gitkeep

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing & coverage
.coverage
htmlcov/
.pytest_cache/
